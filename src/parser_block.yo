// Ported from: lib/parser_block.mjs (markdown-it v14.1.1)
//
// Block-level parser. Dispatches to individual block rules in order.
// Does not use Ruler for now — rule chain is hardcoded.

pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Token } :: import("./token.yo");
{ StateBlock, new_state_block, BlockTokenizeFn } :: import("./rules_block/state_block.yo");
{ BlockRuleFn, lheading } :: import("./rules_block/lheading.yo");

// Block rules
{ code } :: import("./rules_block/code.yo");
{ fence } :: import("./rules_block/fence.yo");
{ heading } :: import("./rules_block/heading.yo");
{ hr } :: import("./rules_block/hr.yo");
{ html_block } :: import("./rules_block/html_block.yo");
{ paragraph } :: import("./rules_block/paragraph.yo");
{ table } :: import("./rules_block/table.yo");
{ reference } :: import("./rules_block/reference.yo");
{ blockquote } :: import("./rules_block/blockquote.yo");
{ list } :: import("./rules_block/list.yo");
{ Env } :: import("./env.yo");
{ replace } :: import("std/mem");

// Wrapper: adapts table to BlockRuleFn signature for use as paragraph terminator.
(_empty_rule_list : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
_table_as_terminator :: (fn(state : *StateBlock, start_line : i32, end_line : i32, silent : bool) -> bool)(table(state, start_line, end_line, silent, addr_of(_empty_rule_list)));

// Pre-built terminator lists — created once in _init_terminators, reused every _block_tokenize call.
(mut(_para_terminators) : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
(mut(_ref_terminators) : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
(mut(_block_terminators) : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
(mut(_para_terminators_no_table) : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
(mut(_ref_terminators_no_table) : ArrayList(BlockRuleFn)) = ArrayList(BlockRuleFn).new();
(mut(_terminators_initialized) : bool) = false;

_init_terminators :: (fn() -> unit)({
  if(_terminators_initialized, {
    return(());
  });
  _terminators_initialized = true;

  // Para terminators with table
  mut(l_para_terminators) := ArrayList(BlockRuleFn).new();
  _ := l_para_terminators.push(_table_as_terminator);
  _ := l_para_terminators.push(fence);
  _ := l_para_terminators.push(blockquote);
  _ := l_para_terminators.push(hr);
  _ := l_para_terminators.push(list);
  _ := l_para_terminators.push(html_block);
  _ := l_para_terminators.push(heading);
  _para_terminators = l_para_terminators;

  // Para terminators without table
  mut(l_para_terminators_no_table) := ArrayList(BlockRuleFn).new();
  _ := l_para_terminators_no_table.push(fence);
  _ := l_para_terminators_no_table.push(blockquote);
  _ := l_para_terminators_no_table.push(hr);
  _ := l_para_terminators_no_table.push(list);
  _ := l_para_terminators_no_table.push(html_block);
  _ := l_para_terminators_no_table.push(heading);
  _para_terminators_no_table = l_para_terminators_no_table;

  // Ref terminators with table
  mut(l_ref_terminators) := ArrayList(BlockRuleFn).new();
  _ := l_ref_terminators.push(_table_as_terminator);
  _ := l_ref_terminators.push(fence);
  _ := l_ref_terminators.push(blockquote);
  _ := l_ref_terminators.push(hr);
  _ := l_ref_terminators.push(list);
  _ := l_ref_terminators.push(html_block);
  _ := l_ref_terminators.push(heading);
  _ref_terminators = l_ref_terminators;

  // Ref terminators without table
  mut(l_ref_terminators_no_table) := ArrayList(BlockRuleFn).new();
  _ := l_ref_terminators_no_table.push(fence);
  _ := l_ref_terminators_no_table.push(blockquote);
  _ := l_ref_terminators_no_table.push(hr);
  _ := l_ref_terminators_no_table.push(list);
  _ := l_ref_terminators_no_table.push(html_block);
  _ := l_ref_terminators_no_table.push(heading);
  _ref_terminators_no_table = l_ref_terminators_no_table;

  // Block terminators (no table variant needed)
  mut(l_block_terminators) := ArrayList(BlockRuleFn).new();
  _ := l_block_terminators.push(code);
  _ := l_block_terminators.push(fence);
  _ := l_block_terminators.push(blockquote);
  _ := l_block_terminators.push(hr);
  _ := l_block_terminators.push(html_block);
  _ := l_block_terminators.push(heading);
  _block_terminators = l_block_terminators;
});

// Standalone block tokenizer — dispatches to block rules in order.
_block_tokenize :: (fn(state : *StateBlock, start_line : i32, end_line : i32) -> unit)({
  _init_terminators();

  (pt : *ArrayList(BlockRuleFn)) = cond(
    state.*.enable_table => addr_of(_para_terminators),
    true => addr_of(_para_terminators_no_table)
  );
  (rt : *ArrayList(BlockRuleFn)) = cond(
    state.*.enable_table => addr_of(_ref_terminators),
    true => addr_of(_ref_terminators_no_table)
  );

  (mut(line) : i32) = start_line;
  (max_nesting : i32) = i32(100);
  (mut(has_empty_lines) : bool) = false;

  while(line < end_line, {
    // JS: state.line = line = state.skip_empty_lines(line)
    line = state.*.skip_empty_lines(line);
    state.*.line = line;
    if(line >= end_line, {
      return(());
    });

    // Termination condition for nested calls (blockquotes, lists)
    if(state.*.s_count(usize(line)) < state.*.blk_indent, {
      return(());
    });

    // If nesting level exceeded — skip to end
    if(state.*.level >= max_nesting, {
      state.*.line = end_line;
      return(());
    });

    // Try rules in order (same order as markdown-it default preset)
    (mut(ok) : bool) = false;
    if(!ok && state.*.enable_table, {
      ok = table(state, line, end_line, false, addr_of(_block_terminators));
    });
    if(!ok, {
      ok = code(state, line, end_line, false);
    });
    if(!ok, {
      ok = fence(state, line, end_line, false);
    });
    if(!ok, {
      ok = blockquote(state, line, end_line, false);
    });
    if(!ok, {
      ok = hr(state, line, end_line, false);
    });
    if(!ok, {
      ok = list(state, line, end_line, false);
    });
    if(!ok, {
      ok = reference(state, line, end_line, false, rt);
    });
    if(!ok, {
      ok = html_block(state, line, end_line, false);
    });
    if(!ok, {
      ok = heading(state, line, end_line, false);
    });
    if(!ok, {
      ok = lheading(state, line, end_line, false, pt);
    });
    if(!ok, {
      ok = paragraph(state, line, end_line, false, pt);
    });

    // Set state.tight based on whether empty lines have been seen before this tag.
    // i.e. latest empty line should not count (matches JS: state.tight = !has_empty_lines)
    state.*.tight = !has_empty_lines;

    // Paragraph might "eat" one newline after it in nested lists
    if(state.*.is_empty(state.*.line - i32(1)), {
      has_empty_lines = true;
    });

    // Update line from state (rule should have advanced it)
    if(!ok, {
      state.*.line = (state.*.line + i32(1));
    });
    line = state.*.line;

    // Check for empty line after the matched rule
    if((line < end_line) && state.*.is_empty(line), {
      has_empty_lines = true;
      line = (line + i32(1));
      state.*.line = line;
    });
  });
});

// Block parser
ParserBlock :: struct(
  _initialized : bool
);

new_parser_block :: (fn() -> ParserBlock)(
  ParserBlock(_initialized : true)
);

impl(
  ParserBlock,
  // Parse block content and fill out_tokens.
  parse : (fn(self : &Self, src : str, env : *Env, out_tokens : &mut ArrayList(Token), html_enabled : bool, enable_table : bool) -> unit)({
    mut(state) := new_state_block(src, env, replace(out_tokens, ArrayList(Token).new()), html_enabled, enable_table, _block_tokenize);
    _block_tokenize(addr_of(state), i32(0), state.line_max);
    out_tokens.* = replace(&mut state.tokens, ArrayList(Token).new());
  })
);

export(ParserBlock, new_parser_block);
