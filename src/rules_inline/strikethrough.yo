// Ported from: lib/rules_inline/strikethrough.mjs (markdown-it v14.1.1)
//
// ~~strike through~~

pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenType } :: import("../token.yo");
{ StateInline, Delimiter, TokenMeta, ScanDelimsResult } :: import("./state_inline.yo");
{ flush_pending, inline_push_token } :: import("./inline_helpers.yo");
{ str_view } :: import("../common/utils.yo");
{ replace } :: import("std/mem");

// Cached marker strings
_TILDE := String.from("~");
_DOUBLE_TILDE := String.from("~~");

// Insert each marker as a separate text token, and add it to delimiter list
strikethrough_tokenize :: (fn(state : *StateInline, silent : bool) -> bool)({
  (start : i32) = state.*.pos;
  (marker : i32) = i32(state.*.src_bytes.bytes(usize(start)));

  if(silent, {
    return(false);
  });

  if(marker != i32(0x7E), {
    return(false);
  });

  (scanned : ScanDelimsResult) = state.*.scan_delims(state.*.pos, true);
  (mut(len) : i32) = scanned.length;

  if(len < i32(2), {
    return(false);
  });

  // If odd count, push one single marker text token and reduce len
  if((len % i32(2)) != i32(0), {
    (mut(token) : Token) = Token.new(.TT_TEXT, "", i32(0));
    (owned_token : String) = _TILDE.clone();
    token.content = str_view(&owned_token);
    token.content_owned = .Some(owned_token);
    token.level = state.*.level;
    inline_push_token(state, token);
    len = (len - i32(1));
  });

  // Push pairs of markers as text tokens + delimiters
  (mut(i) : i32) = i32(0);
  while(i < len, {
    (mut(token) : Token) = Token.new(.TT_TEXT, "", i32(0));
    (owned_token : String) = _DOUBLE_TILDE.clone();
    token.content = str_view(&owned_token);
    token.content_owned = .Some(owned_token);
    token.level = state.*.level;
    inline_push_token(state, token);

    (delim : Delimiter) = Delimiter(
      marker : marker,
      length : i32(0),
      token_idx : (i32(state.*.tokens.len()) - i32(1)),
      end : i32(-1),
      open : scanned.can_open,
      close : scanned.can_close
    );
    _ := state.*.delimiters.push(delim);

    i = (i + i32(2));
  });

  state.*.pos = (state.*.pos + scanned.length);
  true
});

// Walk through delimiter list and replace text tokens with tags
_post_process_strikethrough :: (fn(tokens : &mut ArrayList(Token), delimiters : &ArrayList(Delimiter)) -> unit)({
  (mut(lone_markers) : ArrayList(i32)) = ArrayList(i32).new();
  (max : i32) = i32(delimiters.len());

  (mut(i) : i32) = i32(0);
  while(i < max, {
    (start_delim : Delimiter) = delimiters(usize(i));

    if((start_delim.marker == i32(0x7E)) && (start_delim.end != i32(-1)), {
      (end_delim : Delimiter) = delimiters(usize(start_delim.end));

      // Opening token
      (token_o : *Token) = addr_of(tokens(usize(start_delim.token_idx)));
      token_o.*.type_name = .TT_S_OPEN;
      (s_tag : str) = "s";
      token_o.*.tag = s_tag;
      token_o.*.nesting = i32(1);
      token_o.*.markup = "~~";
      token_o.*.content = "";

      // Closing token
      (token_c : *Token) = addr_of(tokens(usize(end_delim.token_idx)));
      token_c.*.type_name = .TT_S_CLOSE;
      token_c.*.tag = s_tag;
      token_c.*.nesting = i32(-1);
      token_c.*.markup = "~~";
      token_c.*.content = "";

      // Check for lone marker before closing token
      if((end_delim.token_idx - i32(1)) >= i32(0), {
        (prev_tok : *Token) = addr_of(tokens(usize(end_delim.token_idx - i32(1))));
        if((prev_tok.*.type_name == .TT_TEXT) && (prev_tok.*.content == "~"), {
          _ := lone_markers.push(end_delim.token_idx - i32(1));
        });
      });
    });

    i = (i + i32(1));
  });

  // Move lone markers after subsequent s_close tags
  while(lone_markers.len() > usize(0), {
    (idx : i32) = lone_markers.pop().unwrap();
    (mut(j) : i32) = (idx + i32(1));
    while((j < i32(tokens.len())) && (tokens(usize(j)).type_name == .TT_S_CLOSE), {
      j = (j + i32(1));
    });
    j = (j - i32(1));
    if(idx != j, {
      tokens.swap(usize(j), usize(idx));
    });
  });
});

strikethrough_post_process :: (fn(state : *StateInline) -> unit)({
  // The token list is written while the delimiter lists are read: lend the
  // tokens through their own pointer so the two borrows have distinct roots.
  (tp : *ArrayList(Token)) = addr_of(state.*.tokens);
  _post_process_strikethrough(&mut tp.*, &state.*.delimiters);

  (max : i32) = i32(state.*.tokens_meta.len());
  (mut(curr) : i32) = i32(0);
  while(curr < max, {
    // Take the meta out while its list is read, then put it back.
    m := replace(&mut state.*.tokens_meta(usize(curr)), Option(TokenMeta).None);
    match(&m, .Some(tm) => _post_process_strikethrough(&mut tp.*, &tm.delimiters), .None => ());
    state.*.tokens_meta(usize(curr)) = m;
    curr = (curr + i32(1));
  });
});

export(strikethrough_tokenize, strikethrough_post_process);
