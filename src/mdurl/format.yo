// Ported from: mdurl/lib/format.mjs
//
// Reconstruct URL string from parsed Url object.

pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ Url } :: import("./parse.yo");

// Format a Url object back into a URL string.
format :: (fn(url : *Url) -> String)({
  (mut(result) : String) = String.new();

  match(
    &url.*.protocol,
    .Some(p) => {
      result.push_string(&p.*);
    },
    .None => ()
  );

  if(url.*.slashes, {
    result = (result + `//`);
  });

  match(
    &url.*.auth,
    .Some(a) => {
      result.push_string(&a.*);
      result = (result + `@`);
    },
    .None => ()
  );

  match(
    &url.*.hostname,
    .Some(h) => {
      // IPv6 address: wrap in brackets
      if(h.contains(`:`), {
        result = (result + `[`);
        result.push_string(&h.*);
        result = (result + `]`);
      }, {
        result.push_string(&h.*);
      });
    },
    .None => ()
  );

  match(
    &url.*.port,
    .Some(p) => {
      result = (result + `:`);
      result.push_string(&p.*);
    },
    .None => ()
  );

  match(
    &url.*.pathname,
    .Some(p) => {
      result.push_string(&p.*);
    },
    .None => ()
  );

  match(
    &url.*.search,
    .Some(s) => {
      result.push_string(&s.*);
    },
    .None => ()
  );

  match(
    &url.*.hash,
    .Some(h) => {
      result.push_string(&h.*);
    },
    .None => ()
  );

  result
});

export(format);
